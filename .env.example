# ==============================================================================
# SISTEM PERPUSTAKAAN DIGITAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi '.env' di direktori utama sebelum menjalankan aplikasi:
#   copy .env.example .env
# File '.env' diabaikan secara otomatis oleh Git demi alasan keamanan.
# ==============================================================================

# 1. Flask Secret Key (Wajib diganti di lingkungan produksi)
# Digunakan untuk enkripsi sesi dan pengamanan token CSRF
SECRET_KEY=ganti_dengan_kunci_acak_yang_panjang_dan_aman_di_produksi

# 2. Kredensial Administrator Perpustakaan
# Default lokal untuk pengujian: username 'admin' dan password '123'
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat

# Alternatif: Masukkan hash password langsung jika tidak ingin menyimpan password plaintext
# ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...
