# ==============================================================================
# SISTEM PERPUSTAKAAN DIGITAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi '.env' di direktori utama sebelum menjalankan aplikasi:
#   copy .env.example .env
# File '.env' diabaikan secara otomatis oleh Git demi alasan keamanan data.
# ==============================================================================

# 1. Mode Lingkungan Aplikasi (development / production)
# Pada mode 'production', SECRET_KEY dan ADMIN_PASSWORD wajib diganti (startup akan ditolak jika memakai default)
FLASK_ENV=development

# 2. Port & Jaringan Server
# Port server HTTP (default lokal: 5000, cloud container biasanya mengatur $PORT dinamis)
PORT=5000

# 3. Flask Secret Key (WAJIB DIGANTI di mode produksi)
# Digunakan untuk enkripsi sesi, cookie signing, dan pengamanan token CSRF
# Di mode produksi: minimal 16 karakter acak yang kuat dan tidak boleh placeholder
SECRET_KEY=ganti_dengan_kunci_acak_yang_panjang_dan_aman_di_produksi

# 4. Kredensial Administrator Perpustakaan (WAJIB DIGANTI di mode produksi)
# Default lokal untuk pengujian pengembang: username 'admin' dan password '123'
# Di mode produksi: password '123' dan placeholder DITOLAK oleh sistem saat startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat

# Alternatif: Masukkan hash password scrypt/pbkdf2 langsung jika tidak ingin menyimpan password plaintext
# ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...

# 5. Keamanan Cookie Sesi
# Otomatis True di mode produksi (HTTPS). Bisa dioverride secara eksplisit (true/false)
# SESSION_COOKIE_SECURE=true

# 6. Konfigurasi Database SQLite
# Nama file database atau path persisten absolut (contoh di container Linux: /app/data/perpustakaan.db)
DATABASE_NAME=perpustakaan.db
# Timeout antrian penulisan SQLite dalam detik (mencegah error 'database is locked')
SQLITE_TIMEOUT=30.0
# Mode jurnal SQLite (opsional: DELETE / WAL; default sistem mengikuti file database)
# SQLITE_JOURNAL_MODE=DELETE

# 7. Proteksi Khusus Operasi Kritis
# Izinkan fitur pengosongan katalog buku di produksi? (default: false demi keamanan aset)
ALLOW_CATALOG_RESET=false

# 8. Konfigurasi AI Book Assistant (Google Gemini API)
# Dapatkan API Key secara gratis melalui Google AI Studio: https://aistudio.google.com/
# Biarkan kosong jika server tidak menggunakan fitur kecerdasan buatan (graceful fallback aktif)
GEMINI_API_KEY=
# Pilihan model default: gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
